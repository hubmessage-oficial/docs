{
  "openapi": "3.1.0",
  "info": {
    "title": "Hub Message - Enviar Imagem",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://api.hubmessage.io" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar imagem",
        "description": "Envia uma mensagem com imagem.",
        "operationId": "sendImageMessage",
        "tags": ["Mensagens"],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": { "type": "string", "example": "SEU_CHANNEL_ID" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendImageRequest" },
              "example": {
                "recipient": { "identifier": "5511999999999" },
                "content": {
                  "type": "IMAGE",
                  "attachments": [
                    {
                      "url": "https://exemplo.com/imagem.jpg",
                      "caption": "Legenda da imagem"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "400": { "$ref": "#/components/responses/MediaValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/MediaProcessingError" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensagem enviada com sucesso",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "example": { "messageId": "wamid.HBgNNTU0NDk3MDUwNzg1FQIAERgSM0" }
          }
        }
      },
      "MediaValidationError": {
        "description": "Mídia fora das regras (formato, tamanho, legenda ou URL). Trate pelo `errors[].subCode`.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MediaError" },
            "example": {
              "timestamp": "2026-07-13T18:20:00Z",
              "status": 400,
              "errors": [
                {
                  "code": "VALIDATION_ERROR",
                  "subCode": "MEDIA_MIME_NOT_ALLOWED",
                  "message": "Tipo de mídia não permitido para IMAGE: image/heic"
                }
              ]
            }
          }
        }
      },
      "MediaProcessingError": {
        "description": "Falha técnica temporária ao baixar, converter ou armazenar a mídia. Reenvie; se persistir, contate o suporte.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MediaError" },
            "example": {
              "timestamp": "2026-07-13T18:20:00Z",
              "status": 502,
              "errors": [
                {
                  "code": "VALIDATION_ERROR",
                  "subCode": "MEDIA_DOWNLOAD_FAILED",
                  "message": "Não foi possível baixar a mídia da URL informada"
                }
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token inválido ou ausente.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": 401, "message": "Unauthorized" }
          }
        }
      }
    },
    "schemas": {
      "SendImageRequest": {
        "type": "object",
        "required": ["recipient", "content"],
        "properties": {
          "recipient": {
            "type": "object",
            "required": ["identifier"],
            "properties": {
              "identifier": { "type": "string", "description": "Telefone do destinatário (DDI + DDD + número)", "example": "5511999999999" }
            }
          },
          "content": {
            "type": "object",
            "required": ["type", "attachments"],
            "properties": {
              "type": { "type": "string", "description": "Tipo da mensagem", "enum": ["IMAGE"] },
              "attachments": {
                "type": "array",
                "description": "Lista de anexos",
                "items": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {
                    "url": { "type": "string", "description": "URL da imagem" },
                    "caption": { "type": "string", "description": "Legenda da imagem" }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": { "type": "string", "description": "ID da mensagem enviada" }
        }
      },
      "MediaError": {
        "type": "object",
        "description": "Contrato unificado de erro. `errors` pode conter mais de um erro. Trate seu fluxo pelo `errors[].subCode` (estável) — nunca pelo `message`. Campos nulos são omitidos.",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time", "description": "Data/hora do erro (ISO 8601)" },
          "status": { "type": "integer", "description": "Código de status HTTP", "example": 400 },
          "errors": {
            "type": "array",
            "description": "Lista de erros (pode haver mais de um)",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string", "description": "Código geral do erro", "example": "VALIDATION_ERROR" },
                "name": { "type": "string", "description": "Nome do erro" },
                "subCode": { "type": "string", "description": "Código estável do erro de mídia — trate seu fluxo por ele" },
                "message": { "type": "string", "description": "Mensagem legível (pode mudar/ser traduzida — não use para lógica)" },
                "description": { "type": "string", "description": "Detalhes adicionais do erro" }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "integer" },
          "message": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Secret Key gerada no painel de Segurança do Hub Message" }
    }
  }
}
