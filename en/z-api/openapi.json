                "type": "array",
                "description": "List of buttons",
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "properties": {
                    "id": { "type": "string", "description": "Button identifier" },
                    "label": { "type": "string", "description": "Text displayed on the button" }
                  }
                }
              }
            }
          },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendContactRequest": {
        "type": "object",
        "required": ["phone", "contactName", "contactPhone"],
