          "catalogPhone": { "type": "string", "description": "Phone number of the business account that owns the catalog" },
          "translation": { "type": "string", "description": "Catalog card language", "enum": ["EN", "PT"] },
          "message": { "type": "string", "description": "Message accompanying the catalog card" },
          "title": { "type": "string", "description": "Catalog card title" },
          "catalogDescription": { "type": "string", "description": "Catalog card description" }
        }
      },
      "SendProductRequest": {
        "type": "object",
        "required": ["phone", "catalogPhone", "productId"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "catalogPhone": { "type": "string", "description": "Phone number of the business account that owns the product" },
          "productId": { "type": "string", "description": "Product ID in the catalog" }
        }
      },
      "SendRemoveReactionRequest": {
        "type": "object",
        "required": ["phone", "messageId"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "messageId": { "type": "string", "description": "ID of the message whose reaction will be removed" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "zaapId": { "type": "string", "description": "Internal identifier" },
          "messageId": { "type": "string", "description": "WhatsApp message ID" },
          "id": { "type": "string", "description": "Same value as messageId (compatibility)" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "integer", "description": "Error code" },
          "message": { "type": "string", "description": "Error description" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Hub Message Security panel"
      }
    }
  }
